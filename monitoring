        function saveManualUpload() {
            if (!requireAdmin('데이터 입력·업로드')) return;
            const date = document.getElementById('upload-date').value;
            if (!date) {
                alert('년월을 선택하세요.');
                return;
            }

            const row = { date };
            let filled = 0;
            for (const k of INDICATOR_KEYS) {
                const el = document.getElementById(`upload-${k}`);
                const val = el ? el.value.trim() : '';
                if (val !== '') {
                    const num = parseFloat(val);
                    if (isNaN(num)) {
                        alert(`${getIndicatorMeta(k)?.label || k} 값이 올바르지 않습니다.`);
                        return;
                    }
                    row[k] = num;
                    filled++;
                }
            }

            if (filled === 0) {
                alert('최소 1개 이상의 지표값을 입력하세요.');
                return;
            }

            const idx = rawData.findIndex(d => d.date === date);
            if (idx >= 0) {
                rawData[idx] = { ...rawData[idx], ...row };
            } else {
                rawData.push(row);
            }
            rawData.sort((a, b) => a.date.localeCompare(b.date));
            alert(`${date} 데이터 ${filled}개 지표가 저장되었습니다.`);
            saveAndRefresh();
        }

