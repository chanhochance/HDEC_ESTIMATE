        function calculateEscalation() {
            const sDate = document.getElementById('sim-start-date').value;
            const eDate = document.getElementById('sim-end-date').value;
            const input = parseFloat(document.getElementById('sim-base-cost').value) || 0;
            const hasInput = input > 0;
            const fxRates = getFxRatesForSim(sDate, eDate);

            const baseCost = hasInput ? input : 0;
            const baseUsd = simUnit === 'usd' ? baseCost : 0;

            renderSimFxMeta(fxRates);

            const rawResult1 = calcEscalationForIndicator(document.getElementById('sim-indicator-1').value, sDate, eDate, baseCost);
            const rawResult2 = calcEscalationForIndicator(document.getElementById('sim-indicator-2').value, sDate, eDate, baseCost);

            const result1 = enrichEscalationWithFx(rawResult1, baseUsd, fxRates);
            const result2 = enrichEscalationWithFx(rawResult2, baseUsd, fxRates);
            const avgResult = enrichEscalationWithFx(
                calcAverageEscalation(rawResult1, rawResult2, baseCost),
                baseUsd, fxRates
            );

            renderSimUsdFormula(result1, result2, avgResult, fxRates);

            renderEscalationBlock(1, result1, hasInput);
            renderEscalationBlock(2, result2, hasInput);
            renderEscalationBlock('avg', avgResult, hasInput);
        }

