        function calcEscalationForIndicator(indKey, sDate, eDate, baseCost) {
            const meta = getIndicatorMeta(indKey);
            const label = meta?.label || '—';
            const sItem = rawData.find(d => d.date === sDate);
            const eItem = rawData.find(d => d.date === eDate);

            if (!sItem || !eItem || isUnpublishedValue(sItem[indKey]) || isUnpublishedValue(eItem[indKey])) {
                return { valid: false, label };
            }

            const sVal = sItem[indKey];
            const eVal = eItem[indKey];
            const rate = ((eVal - sVal) / sVal) * 100;
            const finalCost = baseCost ? baseCost * (eVal / sVal) : null;
            const diffCost = baseCost ? finalCost - baseCost : null;
            return { valid: true, label, rate, finalCost, diffCost };
        }

        function calcAverageEscalation(result1, result2, baseCost) {
            if (!result1.valid || !result2.valid) {
                return { valid: false, label: '산술평균' };
            }
            const rate = (result1.rate + result2.rate) / 2;
            const finalCost = baseCost ? (result1.finalCost + result2.finalCost) / 2 : null;
            const diffCost = baseCost ? finalCost - baseCost : null;
            return { valid: true, label: '산술평균', rate, finalCost, diffCost };
        }

        function getFxRatesForSim(sDate, eDate) {
            const sItem = rawData.find(d => d.date === sDate);
            const eItem = rawData.find(d => d.date === eDate);
            if (!sItem || !eItem) return null;
            if (isUnpublishedValue(sItem.fx_usd) || isUnpublishedValue(eItem.fx_usd)) return null;
            return { fxBase: sItem.fx_usd, fxChange: eItem.fx_usd };
        }

        function enrichEscalationWithFx(result, baseUsd, fxRates) {
            result.fxValid = false;
            if (!result.valid) {
                return result;
            }
            result.indicatorRatio = 1 + result.rate / 100;
            result.usdRate = result.rate;

            if (baseUsd) {
                result.usdBase = baseUsd;
                result.usdFinal = result.finalCost;
                result.usdDiff = result.usdFinal - result.usdBase;
            }

            if (!fxRates) {
                return result;
            }

            result.fxValid = true;
            result.fxBase = fxRates.fxBase;
            result.fxChange = fxRates.fxChange;

            if (!baseUsd) {
                return result;
            }

            result.krwValueBase = baseUsd * fxRates.fxBase;
            result.krwValueChange = result.usdFinal * fxRates.fxChange;
            result.krwValueDiff = result.krwValueChange - result.krwValueBase;
            return result;
        }

