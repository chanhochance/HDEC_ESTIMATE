                ]
            },
            {
                id: 'other', title: '기타지표', cssClass: 'cat-other',
                indicators: [
                    { key: 'oil_brent', label: '유가\n(브렌트)', unit: ' $/BBL', link: 'https://www.opinet.co.kr/user/main/mainView.do' },
                    { key: 'oil_dubai', label: '유가\n(두바이)', unit: ' $/BBL', link: 'https://www.opinet.co.kr/user/main/mainView.do' },
                    { key: 'fx_usd', label: '환율\n(원/달러)', unit: ' 원', link: 'https://ecos.bok.or.kr/' },
                    { key: 'fx_eur', label: '환율\n(원/유로)', unit: ' 원', link: 'https://ecos.bok.or.kr/' }
                ]
            }
        ];

        const SOURCE_NAME_BY_LINK = {
            'https://cost.kict.re.kr/': '공사비원가관리센터',
            'https://ecos.bok.or.kr/': '한국은행 경제통계시스템',
            'https://www.kpi.or.kr/www/': '한국물가정보',
            'https://www.komis.or.kr/': '한국자원정보서비스',
            'https://www.law.go.kr/LSW/main.html': '국가법령정보센터',
            'https://www.cak.or.kr/index.do': '대한건설협회',
            'https://www.opinet.co.kr/user/main/mainView.do': '한국석유공사 오피넷'
        };

        const SOURCE_DISPLAY_ORDER = [
            'https://cost.kict.re.kr/',
            'https://ecos.bok.or.kr/',
            'https://www.kpi.or.kr/www/',
            'https://www.komis.or.kr/',
            'https://www.law.go.kr/LSW/main.html',
            'https://www.cak.or.kr/index.do',
            'https://www.opinet.co.kr/user/main/mainView.do'
        ];

        /* 물가지표_업로드_템플릿.xlsx / hec_master.csv 표준 컬럼 (17열)
           순서 = 대시보드: 물가지수 → 주요자재 → 국가고시 → 기타지표 */
        const TEMPLATE_COLUMN_ORDER = [
            'date',
            'cci_house', 'cci_nonhouse', 'cpi', 'ppi',
            'rmc', 'st', 'lme_al', 'lme_cu',
            'basic_ground', 'basic_under', 'standard_cost', 'wage_normal',
            'oil_brent', 'oil_dubai', 'fx_usd', 'fx_eur'
        ];

        const UPLOAD_HEADER_TO_KEY = {
            date: 'date', '년월': 'date', '날짜': 'date', yearmonth: 'date', '기준년월': 'date', '적용년월': 'date', '월': 'date',
            cci_house: 'ccpi_res', ccpi_res: 'ccpi_res', '건설공사비지수주거': 'ccpi_res', '건설공사비주거': 'ccpi_res',
            cci_nonhouse: 'ccpi_nonres', cci_nonres: 'ccpi_nonres', ccpi_nonres: 'ccpi_nonres', '건설공사비지수비주거': 'ccpi_nonres', '건설공사비비주거': 'ccpi_nonres',
            cpi: 'cpi', '소비자물가지수': 'cpi', '소비자물가': 'cpi',
            ppi: 'gdp_deflator', gdp_deflator: 'gdp_deflator', '건설투자gdp디플레이터지수': 'gdp_deflator', '건설투자gdp디플레이터': 'gdp_deflator', '건설투자gdp디플': 'gdp_deflator', '건설투자gdp': 'gdp_deflator',
            rmc: 'remicon', remicon: 'remicon', '레미콘': 'remicon',
            st: 'rebar', rebar: 'rebar', '철근': 'rebar',
            lme_al: 'aluminum', aluminum: 'aluminum', '알루미늄': 'aluminum',
            lme_cu: 'copper', copper: 'copper', '구리': 'copper',
            oil_brent: 'oil_brent', '유가브렌트': 'oil_brent', '유가(브렌트)': 'oil_brent',
            oil_dubai: 'oil_dubai', '유가두바이': 'oil_dubai', '유가(두바이)': 'oil_dubai',
            fx_usd: 'fx_usd', '환율원달러': 'fx_usd', '환율(원/달러)': 'fx_usd',
            fx_eur: 'fx_eur', '환율원유로': 'fx_eur', '환율(원/유로)': 'fx_eur',
            basic_ground: 'basic_above', basic_above: 'basic_above', '기본형건축비지상': 'basic_above', '기본형건축비(지상)': 'basic_above', '기본형지상': 'basic_above',
            basic_under: 'basic_below', basic_below: 'basic_below', '기본형건축비지하': 'basic_below', '기본형건축비(지하)': 'basic_below', '기본형지하': 'basic_below',
            standard_cost: 'standard_cost', '표준건축비': 'standard_cost',
            wage_normal: 'standard_labor', standard_labor: 'standard_labor', '표준노임일반': 'standard_labor', '표준노임(일반)': 'standard_labor'
        };

        /* 템플릿 열 순서와 동일 (데이터관리 테이블·업로드 처리) */
        const INDICATOR_KEYS = TEMPLATE_COLUMN_ORDER.slice(1).map(col => UPLOAD_HEADER_TO_KEY[col]);

        function normalizeUploadHeader(value) {
            return String(value == null ? '' : value).trim().toLowerCase()
                .replace(/\s+/g, '')
                .replace(/[()（）]/g, '')
                .replace(/\//g, '')
                .replace(/\./g, '')
                .replace(/-/g, '');
        }

        function fuzzyHeaderToKey(value) {
            const norm = normalizeUploadHeader(value);
            if (!norm) return null;
            if (norm.includes('날짜') || norm === 'date' || norm === '년월') return 'date';
            if (norm.includes('건설공사비') && norm.includes('주거')) return 'ccpi_res';
            if (norm.includes('건설공사비') && norm.includes('비주거')) return 'ccpi_nonres';
            if (norm.includes('소비자물가')) return 'cpi';
            if (norm.includes('건설투자') && (norm.includes('gdp') || norm.includes('디플'))) return 'gdp_deflator';
            if (norm.includes('레미콘')) return 'remicon';
            if (norm.includes('철근')) return 'rebar';
            if (norm.includes('알루미늄')) return 'aluminum';
            if (norm.includes('구리')) return 'copper';
            if (norm.includes('유가') && norm.includes('브렌트')) return 'oil_brent';
            if (norm.includes('유가') && norm.includes('두바이')) return 'oil_dubai';
            if (norm.includes('환율') && (norm.includes('달러') || norm.includes('usd'))) return 'fx_usd';
            if (norm.includes('환율') && (norm.includes('유로') || norm.includes('eur'))) return 'fx_eur';
            if (norm.includes('기본형') && norm.includes('지상')) return 'basic_above';
            if (norm.includes('기본형') && norm.includes('지하')) return 'basic_below';
            if (norm.includes('표준건축비')) return 'standard_cost';
            if (norm.includes('표준노임')) return 'standard_labor';
            return null;
        }

        /* 대시보드 한글 지표명 → 내부키 자동 등록 */
        INDICATOR_CATEGORIES.forEach(cat => {
            cat.indicators.forEach(ind => {
                UPLOAD_HEADER_TO_KEY[normalizeUploadHeader(ind.label)] = ind.key;
            });
        });

        function resolveTemplateColumn(value) {
            const raw = String(value == null ? '' : value).trim();
            if (!raw) return null;
            const lower = raw.toLowerCase();
            if (TEMPLATE_COLUMN_ORDER.includes(lower)) return lower;
            const norm = normalizeUploadHeader(raw);
            if (TEMPLATE_COLUMN_ORDER.includes(norm)) return norm;
            const internal = UPLOAD_HEADER_TO_KEY[norm] || UPLOAD_HEADER_TO_KEY[lower];
            if (!internal) return null;
            if (internal === 'date') return 'date';
            for (const col of TEMPLATE_COLUMN_ORDER) {
                if (UPLOAD_HEADER_TO_KEY[col] === internal) return col;
            }
            return null;
        }

        function resolveUploadHeader(value) {
            const raw = String(value == null ? '' : value).trim();
            if (!raw) return null;
            const norm = normalizeUploadHeader(raw);
            if (UPLOAD_HEADER_TO_KEY[norm]) return UPLOAD_HEADER_TO_KEY[norm];
            if (UPLOAD_HEADER_TO_KEY[raw.toLowerCase()]) return UPLOAD_HEADER_TO_KEY[raw.toLowerCase()];
            const fuzzy = fuzzyHeaderToKey(raw);
            if (fuzzy) return fuzzy;
            if (INDICATOR_KEYS.includes(norm)) return norm;
            if (INDICATOR_KEYS.includes(raw)) return raw;
            return null;
        }

        function normalizeUploadDate(value) {
            if (value == null || value === '') return null;
            if (value instanceof Date && !isNaN(value)) {
                return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}`;
            }
            if (typeof value === 'number' && !isNaN(value)) {
                const intVal = Math.floor(value);
                const s = String(intVal);
                if (s.length === 6 && intVal >= 190001 && intVal <= 210012) {
                    return `${s.slice(0, 4)}-${s.slice(4, 6)}`;
                }
                if (typeof XLSX !== 'undefined' && XLSX.SSF) {
                    const parsed = XLSX.SSF.parse_date_code(value);
                    if (parsed && parsed.y >= 1990 && parsed.y <= 2100) {
                        return `${parsed.y}-${String(parsed.m).padStart(2, '0')}`;
                    }
                }
            }
            const text = String(value).trim()
                .replace(/년/g, '-').replace(/월/g, '')
                .replace(/\./g, '-').replace(/\//g, '-')
                .replace(/\s+/g, '');
            const ymd = text.match(/^(\d{4})-(\d{1,2})(?:-\d{1,2})?$/);
            if (ymd) return `${ymd[1]}-${String(ymd[2]).padStart(2, '0')}`;
            const compact = text.match(/^(\d{4})(\d{2})$/);
            if (compact) return `${compact[1]}-${compact[2]}`;
            return null;
        }

        function parseUploadNumber(value) {
            if (value == null || value === '') return null;
            if (typeof value === 'number' && !isNaN(value)) return value;
            const cleaned = String(value).replace(/,/g, '').trim();
            if (cleaned === '' || cleaned === '-') return null;
            if (cleaned.startsWith('=')) return null;
            if (/^#(REF!|N\/A|VALUE!|DIV\/0!|NUM!|NAME\?|NULL!)/i.test(cleaned)) return null;
            const num = parseFloat(cleaned);
            return isNaN(num) ? null : num;
        }

        function mergeUploadRowIntoRawData(row) {
            const date = normalizeUploadDate(row.date);
            if (!date) return false;
            const internal = { date };
            let hasValue = false;
            Object.keys(row).forEach(key => {
                if (key === 'date') return;
                const internalKey = resolveUploadHeader(key) || (INDICATOR_KEYS.includes(key) ? key : null);
                if (!internalKey || internalKey === 'date') return;
                const num = parseUploadNumber(row[key]);
                if (num != null) {
                    internal[internalKey] = num;
                    hasValue = true;
                }
            });
            if (!hasValue) return false;
            const idx = rawData.findIndex(d => d.date === date);
            if (idx >= 0) rawData[idx] = { ...rawData[idx], ...internal };
            else rawData.push(internal);
            return true;
        }

        function ingestUploadRows(rows) {
            let mergedCount = 0;
            rows.forEach(row => {
                if (mergeUploadRowIntoRawData(row)) mergedCount++;
            });
            if (mergedCount > 0) rawData.sort((a, b) => a.date.localeCompare(b.date));
            return mergedCount;
        }

        function normalizeUploadRow(rowObj) {
            const date = normalizeUploadDate(rowObj.date ?? rowObj.년월);
            if (!date) return null;
            const normalized = { date };
            TEMPLATE_COLUMN_ORDER.slice(1).forEach(templateKey => {
                const internalKey = UPLOAD_HEADER_TO_KEY[templateKey];
                const val = parseUploadNumber(rowObj[templateKey] ?? rowObj[internalKey]);
                if (val != null) normalized[internalKey] = val;
            });
            INDICATOR_KEYS.forEach(k => {
                if (normalized[k] != null) return;
                const val = parseUploadNumber(rowObj[k]);
                if (val != null) normalized[k] = val;
            });
            return Object.keys(normalized).length > 1 ? normalized : null;
        }

        function scoreHeaderRow(cells) {
            let score = 0;
            (cells || []).forEach(cell => {
                const col = resolveTemplateColumn(cell);
                const key = resolveUploadHeader(cell);
                if (col === 'date' || key === 'date') score += 3;
                else if (col && col !== 'date') score += 2;
                else if (key && key !== 'date') score += 1;
            });
            return score;
        }

        function findDateColumnIndex(headerCells) {
            for (let i = 0; i < (headerCells || []).length; i++) {
                const col = resolveTemplateColumn(headerCells[i]);
                const key = resolveUploadHeader(headerCells[i]);
                if (col === 'date' || key === 'date') return i;
            }
            return 0;
        }

        function buildRowObjFromCells(cells, headerCells, mode, dateColIdx = 0) {
            const rowObj = {};
            if (mode === 'positional') {
                TEMPLATE_COLUMN_ORDER.forEach((col, i) => {
                    const idx = dateColIdx + i;
                    if (cells[idx] !== '' && cells[idx] != null) rowObj[col] = cells[idx];
                });
                return rowObj;
            }
            headerCells.forEach((header, i) => {
                const templateCol = resolveTemplateColumn(header);
                const internalKey = resolveUploadHeader(header);
                if (!templateCol && !internalKey) return;
                if (cells[i] === '' || cells[i] == null) return;
                if (templateCol === 'date' || internalKey === 'date') rowObj.date = cells[i];
                else if (templateCol) rowObj[templateCol] = cells[i];
                else rowObj[internalKey] = cells[i];
            });
            return rowObj;
        }

        function parseRowByHeaderMap(cells, colMap) {
            const normalized = {};
            colMap.forEach((key, i) => {
                if (!key || cells[i] === '' || cells[i] == null) return;
                if (key === 'date') {
                    const d = normalizeUploadDate(cells[i]);
                    if (d) normalized.date = d;
                } else {
                    const val = parseUploadNumber(cells[i]);
                    if (val != null) normalized[key] = val;
                }
            });
            return normalized.date && Object.keys(normalized).length > 1 ? normalized : null;
        }

        function parseSheetRows(rows) {
            if (!rows.length) return [];

            let headerRowIdx = 0;
            let bestScore = -1;
            for (let r = 0; r < Math.min(rows.length, 25); r++) {
                const score = scoreHeaderRow(rows[r]);
                if (score > bestScore) {
                    bestScore = score;
                    headerRowIdx = r;
                }
            }

            const headerCells = rows[headerRowIdx] || [];
            const colMap = headerCells.map(h => resolveUploadHeader(h));
            const mappedCount = colMap.filter(Boolean).length;

            if (mappedCount >= 3) {
                const headerResult = [];
                for (let r = headerRowIdx + 1; r < rows.length; r++) {
                    const cells = [...(rows[r] || [])];
                    if (!cells.some(c => c !== '' && c != null)) continue;
                    const normalized = parseRowByHeaderMap(cells, colMap);
                    if (normalized) headerResult.push(normalized);
                }
                if (headerResult.length) return headerResult;
            }

            const dateColIdx = findDateColumnIndex(headerCells);
            const headerSlice = [...headerCells];
            while (headerSlice.length < TEMPLATE_COLUMN_ORDER.length + dateColIdx) headerSlice.push('');
            const recognized = headerCells.filter(c => resolveTemplateColumn(c) || resolveUploadHeader(c)).length;
            const headerGaps = headerSlice
                .slice(dateColIdx, dateColIdx + TEMPLATE_COLUMN_ORDER.length)
                .filter(h => !String(h ?? '').trim()).length;
            const usePositional = recognized < 8 || headerGaps > 2;

            const parseDataRows = (positional) => {
                const result = [];
                for (let r = headerRowIdx + 1; r < rows.length; r++) {
                    const cells = [...(rows[r] || [])];
                    const needLen = dateColIdx + TEMPLATE_COLUMN_ORDER.length;
                    while (cells.length < needLen) cells.push('');
                    if (!cells.some(c => c !== '' && c != null)) continue;
                    const rowObj = buildRowObjFromCells(cells, headerCells, positional ? 'positional' : 'header', dateColIdx);
                    const normalized = normalizeUploadRow(rowObj);
                    if (normalized) result.push(normalized);
                }
                return result;
            };

            let result = parseDataRows(usePositional);
            if (!result.length && !usePositional) result = parseDataRows(true);

            if (!result.length) {
                for (let r = 0; r < rows.length; r++) {
                    if (r === headerRowIdx || scoreHeaderRow(rows[r]) >= 8) continue;
                    const cells = [...(rows[r] || [])];
                    while (cells.length < TEMPLATE_COLUMN_ORDER.length) cells.push('');
                    const dateVal = normalizeUploadDate(cells[dateColIdx] ?? cells[0]);
                    if (!dateVal) continue;
                    const normalized = normalizeUploadRow(buildRowObjFromCells(cells, [], 'positional', dateColIdx));
                    if (normalized) result.push(normalized);
                }
            }
            return result;
        }

        function getSheetCellValue(cell) {
            if (!cell) return '';
            if (cell.t === 'n' && cell.v === 0) return 0;
            if (cell.v != null && cell.v !== '') return cell.v;
            if (cell.w != null && cell.w !== '') return cell.w;
            return '';
        }

        function sheetToRowArrays(sheet) {
            if (!sheet) return [];
            const ref = sheet['!ref'];
            if (!ref) return [];
            let range;
            try {
                range = XLSX.utils.decode_range(ref);
            } catch (e) {
                return XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
            }
            const endCol = Math.max(range.e.c, TEMPLATE_COLUMN_ORDER.length + 2);
            const rows = [];
            for (let r = range.s.r; r <= range.e.r; r++) {
                const row = [];
                for (let c = 0; c <= endCol; c++) {
                    row.push(getSheetCellValue(sheet[XLSX.utils.encode_cell({ r, c })]));
                }
                rows.push(row);
            }
            return rows;
        }

        function selectUploadSheet(workbook) {
            const names = workbook.SheetNames || [];
            const exact = names.find(n => String(n).trim().toUpperCase() === 'UP');
            if (exact && workbook.Sheets[exact]) return { sheet: workbook.Sheets[exact], name: exact };
            const prefer = ['up', 'upload', '업로드', '원장', 'master', 'data'];
            for (const key of prefer) {
                const found = names.find(n => String(n).trim().toLowerCase().includes(key));
                if (found && workbook.Sheets[found]) return { sheet: workbook.Sheets[found], name: found };
            }
            const first = names[0];
            return first ? { sheet: workbook.Sheets[first], name: first } : { sheet: null, name: '' };
        }

        function sheetRowsToObjects(sheet) {
            if (!sheet) return [];
            try {
                return parseSheetRows(sheetToRowArrays(sheet));
            } catch (e) {
                console.warn('sheet parse fallback', e);
                const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
                return parseSheetRows(rows);
            }
        }

        function parseWorkbookUpload(workbook) {
            const primary = selectUploadSheet(workbook);
            if (primary.sheet) {
                const parsed = sheetRowsToObjects(primary.sheet);
                if (parsed.length) return { rows: parsed, sheetName: primary.name };
            }
            for (const name of workbook.SheetNames || []) {
                if (name === primary.name) continue;
                const sheet = workbook.Sheets[name];
                if (!sheet) continue;
                const parsed = sheetRowsToObjects(sheet);
                if (parsed.length) return { rows: parsed, sheetName: name };
            }
            if (primary.sheet) {
                return { rows: sheetRowsToObjects(primary.sheet), sheetName: primary.name };
            }
            return { rows: [], sheetName: '' };
        }

        function parseCsvText(text) {
            const lines = text.replace(/^\uFEFF/, '').split(/\r?\n/).map(l => l.trim()).filter(Boolean);
            if (!lines.length) return [];

            const splitLine = (line) => {
                if (line.includes('\t')) return line.split('\t');
                return line.split(',').map(v => v.trim());
            };

            let headerRowIdx = 0;
            let bestScore = -1;
            for (let i = 0; i < Math.min(lines.length, 5); i++) {
                const score = splitLine(lines[i]).filter(cell => resolveUploadHeader(cell)).length;
                if (score > bestScore) {
                    bestScore = score;
                    headerRowIdx = i;
                }
            }

            const header = splitLine(lines[headerRowIdx]);
            const usePositional = header.filter(h => resolveUploadHeader(h)).length < 5;

            const rows = [];
            for (let i = headerRowIdx + 1; i < lines.length; i++) {
                const parts = splitLine(lines[i]);
                if (!parts.length || !parts[0]) continue;

                const rowObj = {};
                if (usePositional && parts.length >= 17) {
                    TEMPLATE_COLUMN_ORDER.forEach((col, idx) => { rowObj[col] = parts[idx]; });
                } else {
                    header.forEach((h, idx) => {
                        const key = resolveUploadHeader(h);
                        if (key) rowObj[key] = parts[idx];
                    });
                }

                rowObj.date = normalizeUploadDate(rowObj.date);
                if (!rowObj.date) continue;

                const normalized = { date: rowObj.date };
                TEMPLATE_COLUMN_ORDER.slice(1).forEach(templateKey => {
                    const internalKey = UPLOAD_HEADER_TO_KEY[templateKey];
                    const val = parseUploadNumber(rowObj[templateKey] ?? rowObj[internalKey]);
                    if (val != null) normalized[internalKey] = val;
                });
                if (Object.keys(normalized).length > 1) rows.push(normalized);
            }
            return rows;
        }

        function getTemplateKoreanHeaders() {
            return TEMPLATE_COLUMN_ORDER.map(col => {
                if (col === 'date') return '날짜';
                const internalKey = UPLOAD_HEADER_TO_KEY[col];
                for (const cat of INDICATOR_CATEGORIES) {
                    const found = cat.indicators.find(i => i.key === internalKey);
                    if (found) return found.label;
                }
                return col;
            });
        }

        function buildExportRowArray(row) {
            return TEMPLATE_COLUMN_ORDER.map(col => {
                if (col === 'date') return row.date || '';
                const key = UPLOAD_HEADER_TO_KEY[col];
                const val = row[key];
                if (isUnpublishedValue(val)) return '';
                return val;
            });
        }

        function downloadAllDataXlsx() {
            if (typeof XLSX === 'undefined') {
                alert('엑셀 라이브러리를 불러오지 못했습니다.\n인터넷 연결 후 페이지를 새로고침하고 다시 시도해 주세요.');
                return;
            }
            if (rawData.length === 0) {
                alert('다운로드할 월별 데이터가 없습니다.');
                return;
            }

            const headers = getTemplateKoreanHeaders();
            const dataRows = rawData.map(buildExportRowArray);
            const ws = XLSX.utils.aoa_to_sheet([headers, ...dataRows]);
            ws['!cols'] = TEMPLATE_COLUMN_ORDER.map((col, i) => ({
                wch: i === 0 ? 11 : col.length > 10 ? 20 : 16
            }));

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, '월별데이터');
            const stamp = new Date().toISOString().slice(0, 10);
            XLSX.writeFile(wb, `물가지표_월별데이터_${stamp}.xlsx`);
        }

        function downloadUploadTemplateXlsx() {
