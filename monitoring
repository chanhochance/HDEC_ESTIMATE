                return;
            }
            const headers = getTemplateKoreanHeaders();
            const keys = [...TEMPLATE_COLUMN_ORDER];
            const blankRow = () => Array(TEMPLATE_COLUMN_ORDER.length).fill('');
            const upRows = [headers];
            for (let i = 0; i < 36; i++) upRows.push(blankRow());

            const ws = XLSX.utils.aoa_to_sheet(upRows);
