<body class="flex flex-col min-h-screen">

    <!-- Login Gate -->
    <div id="login-gate" class="fixed inset-0 z-50 flex flex-col items-center justify-center">
        <div class="login-card p-8 w-full max-w-md text-center mx-4">
            <div class="flex justify-center mb-4 text-blue-600">
                <i data-lucide="lock" class="w-12 h-12"></i>
            </div>
            <h2 class="text-2xl mb-6">물가지표 대시보드</h2>
            <input type="password" id="gate-password" placeholder="비밀번호 입력" autofocus
                onkeydown="if(event.key === 'Enter') checkGatePassword()"
                class="w-full p-3 rounded-xl border text-center mb-4 focus:outline-none focus:border-blue-500"
                style="border-color: var(--line); background: #f8f8f6;">
            <button onclick="checkGatePassword()" class="btn-primary w-full p-3">
                인증 및 접속
            </button>
            <p id="gate-error" class="text-red-500 text-xs mt-3 hidden">비밀번호가 올바르지 않습니다.</p>
        </div>
    </div>

    <div id="main-content" class="hidden flex-1 flex flex-col">

