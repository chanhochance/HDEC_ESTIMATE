<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>주요 물가지표 통합 모니터링 및 공사비 시뮬레이터</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        :root {
            --bg: #efefed;
            --grid: rgba(0, 97, 254, .16);
            --text: #151515;
            --muted: #5e6574;
            --white: #fff;
            --blue: #0061fe;
            --green: #0b7a5f;
            --navy: #1F2B40;
            --yellow: #F4C544;
            --orange: #F07A1A;
            --sky: #7DC8DC;
            --skyText: #0B3346;
            --wine: #7C1E45;
            --wineText: #F6D5DF;
            --brown: #5A3A00;
            --line: rgba(0, 0, 0, .08);
            --shadow: 0 18px 46px rgba(0, 0, 0, .12);
            --content: min(1360px, calc(100vw - 56px));
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            color: var(--text);
            background-color: var(--bg);
            background-image:
                linear-gradient(to right, var(--grid) 1px, transparent 1px),
                linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
            background-size: 165px 100%, 100% 124px;
            font-family: 'Noto Sans KR', 'Malgun Gothic', sans-serif;
            -webkit-font-smoothing: antialiased;
            word-break: keep-all;
            min-height: 100vh;
        }

        .hidden {
            display: none !important;
        }

        /* Login gate */
        #login-gate {
            background-color: var(--navy);
            background-image:
                linear-gradient(to right, rgba(255, 255, 255, .06) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, .06) 1px, transparent 1px);
            background-size: 165px 100%, 100% 124px;
        }

        .login-card {
            background: rgba(255, 255, 255, .92);
            backdrop-filter: blur(12px);
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: var(--shadow);
            color: var(--text);
        }

        .login-card h2 {
            letter-spacing: -.03em;
            font-weight: 900;
        }

        .btn-primary {
            background: var(--blue);
            color: #fff;
            font-weight: 800;
            border: none;
            border-radius: 999px;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 26px rgba(0, 97, 254, .25);
        }

        /* Top bar */
        .topbar {
            position: sticky;
            top: 14px;
            z-index: 80;
            width: var(--content);
            max-width: 100%;
            margin: 14px auto 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .brand-chip,
        .nav-chip,
        .meta-chip {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 1px solid rgba(0, 0, 0, .08);
            background: rgba(255, 255, 255, .84);
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 26px rgba(0, 0, 0, .07);
            border-radius: 999px;
            color: var(--text);
        }

        .brand-chip {
            padding: 10px 16px;
        }

        .brand-chip .badge {
            background: var(--blue);
            color: #fff;
            font-size: 11px;
            font-weight: 900;
            padding: 4px 8px;
            border-radius: 6px;
            letter-spacing: .04em;
        }

        .brand-chip strong {
            font-size: 14px;
            font-weight: 900;
            letter-spacing: -.02em;
        }

        .meta-chip {
            padding: 10px 14px;
            font-size: 12px;
            font-weight: 700;
            color: var(--muted);
        }

        .nav-chip {
            padding: 11px 16px;
            border: none;
            cursor: pointer;
            font-weight: 800;
            font-size: 13px;
            transition: transform .2s ease;
        }

        .nav-chip:hover {
            transform: translateY(-1px);
        }

        .nav-chip.admin {
            color: var(--wine);
        }

        .tab-bar {
            width: var(--content);
            max-width: 100%;
            margin: 12px auto 0;
            display: flex;
            gap: 8px;
            padding: 6px;
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(8px);
            border: 1px solid var(--line);
            border-radius: 999px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .05);
        }

        .tab-btn {
            flex: 1;
            padding: 11px 18px;
            border: none;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            color: var(--muted);
            background: transparent;
            cursor: pointer;
            transition: all .2s ease;
        }

        .tab-btn.active {
            background: var(--navy);
            color: #fff;
            box-shadow: 0 6px 16px rgba(31, 43, 64, .25);
        }

        .tab-btn:not(.active):hover {
            background: rgba(0, 0, 0, .04);
        }

        /* Main layout */
        .page-shell {
            width: var(--content);
            max-width: 100%;
            margin: 0 auto;
            padding: 20px 0 40px;
        }

        /* Category indicator rows */
        .category-section {
            margin-bottom: 10px;
        }

        .category-row {
            display: grid;
            grid-template-columns: 88px repeat(4, minmax(0, 1fr));
            gap: 8px;
            align-items: stretch;
        }

        @media (max-width: 900px) {
            .category-row {
                grid-template-columns: 1fr 1fr;
            }

            .category-label {
                grid-column: 1 / -1;
            }
        }

        .category-label {
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 12px 8px;
            border-radius: 14px;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: -.02em;
            line-height: 1.3;
            color: #fff;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .07);
        }

        .category-label.cat-price {
            background: var(--navy);
        }

        .category-label.cat-material {
            background: var(--orange);
            color: #3D1A00;
        }

        .category-label.cat-gov {
            background: var(--wine);
            color: var(--wineText);
        }

        .category-label.cat-other {
            background: var(--sky);
            color: var(--skyText);
        }

        .view-month-bar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 0;
            flex-shrink: 0;
            padding: 10px 14px;
            background: rgba(255, 255, 255, .88);
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .04);
        }

        .view-month-bar label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
        }

        .view-month-bar select {
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 700;
            background: #fff;
        }

        .indicator-card {
            background: rgba(255, 255, 255, .92);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 10px 12px;
            display: flex;
            flex-direction: row;
            align-items: center;
            min-height: 72px;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .04);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .indicator-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, .08);
        }

        .indicator-card .card-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 4px;
        }

        .indicator-card .card-title {
            font-size: 11px;
            font-weight: 900;
            color: var(--muted);
            letter-spacing: -.01em;
            line-height: 1.3;
        }

        .indicator-card .card-body {
            flex: 1;
            min-width: 0;
        }

        .indicator-card .card-main-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            margin-top: 4px;
        }

        .indicator-card .card-val {
            margin-top: 0;
            font-size: clamp(14px, 1.4vw, 18px);
            font-weight: 900;
            letter-spacing: -.03em;
            color: var(--text);
            white-space: nowrap;
        }

        .indicator-card .card-changes {
            margin-top: 0;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
            font-size: 9px;
            font-weight: 700;
            text-align: right;
            white-space: nowrap;
        }

        .indicator-card .up {
            color: #c0392b;
        }

        .indicator-card .down {
            color: var(--blue);
        }

        .indicator-card .flat {
            color: var(--muted);
        }

        .indicator-card a {
            color: var(--muted);
            opacity: .7;
        }

        .indicator-card a:hover {
            opacity: 1;
            color: var(--blue);
        }

        .indicator-card-clickable {
            cursor: pointer;
        }

        /* Indicator history modal */
        .indicator-modal {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .indicator-modal.hidden {
            display: none;
        }

        .indicator-modal-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, .45);
            backdrop-filter: blur(3px);
        }

        .indicator-modal-panel {
            position: relative;
            width: min(480px, 100%);
            max-height: min(80vh, 640px);
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 24px 48px rgba(0, 0, 0, .18);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .indicator-modal-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 18px 18px 12px;
            border-bottom: 1px solid var(--line);
        }

        .indicator-modal-header h3 {
            margin: 6px 0 0;
            font-size: 17px;
            font-weight: 900;
            letter-spacing: -.03em;
        }

        .indicator-modal-cat {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
        }

        .indicator-modal-cat.tag-price {
            background: var(--navy);
            color: #fff;
        }

        .indicator-modal-cat.tag-material {
            background: var(--orange);
            color: #3D1A00;
        }

        .indicator-modal-cat.tag-gov {
            background: var(--wine);
            color: var(--wineText);
        }

        .indicator-modal-cat.tag-other {
            background: var(--sky);
            color: var(--skyText);
        }

        .indicator-modal-close {
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #fff;
            font-size: 20px;
            line-height: 1;
            color: var(--muted);
            cursor: pointer;
        }

        .indicator-modal-close:hover {
            background: #f5f5f5;
            color: var(--text);
        }

        .indicator-modal-meta {
            margin: 0;
            padding: 0 18px 10px;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
        }

        .indicator-modal-body {
            flex: 1;
            overflow-y: auto;
            padding: 0 12px 12px;
        }

        .indicator-history-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        .indicator-history-table th,
        .indicator-history-table td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--line);
            text-align: center;
        }

        .indicator-history-table th {
            position: sticky;
            top: 0;
            background: #f8f9fb;
            font-size: 11px;
            font-weight: 900;
            color: var(--muted);
            z-index: 1;
        }

        .indicator-history-table td:first-child {
            font-weight: 800;
        }

        .indicator-history-table td:nth-child(2) {
            font-weight: 900;
        }

        .indicator-history-table tr.is-current {
            background: rgba(0, 97, 254, .06);
        }

        .indicator-history-table tr.is-current td:first-child {
            color: var(--blue);
        }

        .indicator-history-table .up {
            color: #c0392b;
            font-weight: 800;
        }

        .indicator-history-table .down {
            color: var(--blue);
            font-weight: 800;
        }

        .indicator-history-table .flat {
            color: var(--muted);
            font-weight: 700;
        }

        /* Panels */
        .panel {
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(4px);
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .035);
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }

        .section-title .step {
            display: inline-grid;
            place-items: center;
            width: 28px;
            height: 28px;
            border-radius: 999px;
            background: var(--navy);
            color: #fff;
            font-size: 12px;
            font-weight: 900;
        }

        .section-title h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            letter-spacing: -.03em;
        }

        .section-heading-with-icon {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            letter-spacing: -.03em;
            color: var(--ink);
        }

        .section-heading-with-icon i,
        .section-heading-with-icon svg {
            flex-shrink: 0;
            color: var(--navy);
        }

        .dashboard-section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }

        .dashboard-section-head .section-heading-with-icon {
            flex: 1;
            min-width: 0;
        }

        .simulator-panel .section-heading-with-icon {
            color: #fff;
            font-size: 16px;
            letter-spacing: -.02em;
            border-bottom: 1px solid rgba(255, 255, 255, .2);
            padding-bottom: 12px;
            margin-bottom: 16px;
            width: 100%;
        }

        .simulator-panel .section-heading-with-icon i,
        .simulator-panel .section-heading-with-icon svg {
            color: #fff;
        }

        /* Chart + Simulator equal height */
        @media (min-width: 1024px) {
            .dashboard-chart-sim-grid {
                align-items: stretch;
            }

            .chart-panel,
            .simulator-panel {
                display: flex;
                flex-direction: column;
                height: 100%;
                min-height: 0;
            }

            .chart-canvas-area {
                flex: 1 1 auto;
                min-height: 220px;
                height: auto;
            }

            .chart-canvas-area canvas {
                display: block;
                width: 100% !important;
                height: 100% !important;
            }

            .simulator-body {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 16px;
                min-height: 0;
            }

            .simulator-panel #sim-results-wrap {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
        }

        .chart-sim-save-row {
            display: flex;
            justify-content: flex-end;
            margin-top: 12px;
        }

        .chart-sim-save-row .btn-download {
            width: auto;
            min-width: 148px;
            padding: 10px 20px;
            background: var(--navy);
            border-color: transparent;
            color: #fff;
        }

        .chart-sim-save-row .btn-download:hover {
            background: #0a2d5c;
        }

        #capture-area {
            background: var(--bg);
        }

        /* Chart multi-select */
        .chart-head-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 6px;
        }

        .chart-head-row .section-title {
            margin-bottom: 0;
            flex: 1;
            min-width: 0;
        }

        .chart-head-right {
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
            max-width: min(420px, 52%);
        }

        .chart-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
            justify-content: flex-end;
            margin-bottom: 0;
        }

        .chart-base-select {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            white-space: nowrap;
        }

        .chart-base-select select {
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 5px 10px;
            font-size: 11px;
            font-weight: 700;
            background: #fff;
            max-width: 108px;
        }

        .chart-select-toolbar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 6px;
        }

        .chart-deselect-btn {
            padding: 4px 12px;
            border: 1px solid var(--line);
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
            color: var(--muted);
            background: #fff;
            cursor: pointer;
            transition: all .2s ease;
        }

        .chart-deselect-btn:hover:not(:disabled) {
            border-color: var(--blue);
            color: var(--blue);
        }

        .chart-deselect-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            .chart-head-row {
                flex-direction: column;
                gap: 8px;
            }

            .chart-head-right {
                max-width: 100%;
                align-items: flex-start;
            }

            .chart-note {
                text-align: left;
            }

            .chart-controls {
                justify-content: flex-start;
            }
        }

        .chart-select-panel {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 10px;
        }

        .chart-canvas-area {
            position: relative;
            width: 100%;
            min-height: 280px;
            height: 280px;
        }

        .chart-select-group {
            display: grid;
            grid-template-columns: 76px repeat(4, minmax(0, 1fr));
            gap: 6px;
            align-items: stretch;
        }

        .chart-select-group .group-label {
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8px 4px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: -.02em;
            line-height: 1.25;
            margin-bottom: 0;
            color: #fff;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .06);
        }

        .chart-select-group .group-label.cat-price {
            background: var(--navy);
        }

        .chart-select-group .group-label.cat-material {
            background: var(--orange);
            color: #3D1A00;
        }

        .chart-select-group .group-label.cat-gov {
            background: var(--wine);
            color: var(--wineText);
        }

        .chart-select-group .group-label.cat-other {
            background: var(--sky);
            color: var(--skyText);
        }

        .chart-btn {
            width: 100%;
            min-width: 0;
            min-height: 40px;
            padding: 6px 3px;
            border: 1px solid var(--line);
            border-radius: 10px;
            font-size: 9px;
            font-weight: 800;
            color: var(--muted);
            background: #fff;
            cursor: pointer;
            transition: all .2s ease;
            text-align: center;
            line-height: 1.25;
            white-space: normal;
            word-break: keep-all;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chart-btn.active {
            background: var(--navy);
            color: #fff;
            border-color: var(--navy);
        }

        .chart-select-group.cat-material .chart-btn.active {
            background: var(--orange);
            color: #3D1A00;
            border-color: var(--orange);
        }

        .chart-select-group.cat-gov .chart-btn.active {
            background: var(--wine);
            color: var(--wineText);
            border-color: var(--wine);
        }

        .chart-select-group.cat-other .chart-btn.active {
            background: var(--sky);
            color: var(--skyText);
            border-color: var(--sky);
        }

        .chart-note {
            font-size: 10px;
            color: var(--muted);
            font-weight: 600;
            margin-bottom: 0;
            text-align: right;
            line-height: 1.35;
        }

        .chart-head-right .meta-edit-block {
            text-align: right;
            min-width: 220px;
        }

        .chart-head-right .meta-edit-block label {
            font-size: 10px;
        }

        .chart-head-right .admin-textarea {
            font-size: 11px;
            min-height: 48px;
        }

        /* Simulator hero card */
        .simulator-panel {
            background: var(--blue);
            color: #fff;
            border-radius: 18px;
            box-shadow: var(--shadow);
            padding: 24px;
        }

        .simulator-panel label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            opacity: .75;
            margin-bottom: 4px;
        }

        .simulator-panel select,
        .simulator-panel input {
            width: 100%;
            background: rgba(255, 255, 255, .12);
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: 10px;
            padding: 10px 12px;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
        }

        .simulator-panel select option {
            color: var(--text);
        }

        .simulator-panel input::placeholder {
