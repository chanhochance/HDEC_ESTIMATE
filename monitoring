        function getChartDateRange() {
            if (rawData.length === 0) return [];
            const baseDate = document.getElementById('chart-base-date')?.value;
            const changeDate = document.getElementById('chart-change-date')?.value;
            if (!baseDate || !changeDate) return rawData;
            const i1 = rawData.findIndex(d => d.date === baseDate);
            const i2 = rawData.findIndex(d => d.date === changeDate);
            if (i1 < 0 || i2 < 0) return rawData;
            const start = Math.min(i1, i2);
            const end = Math.max(i1, i2);
            return rawData.slice(start, end + 1);
        }

        function getIndexedSeries(key, baseDate, chartData) {
            const data = chartData || rawData;
            const baseItem = rawData.find(d => d.date === baseDate);
            if (!baseItem || isUnpublishedValue(baseItem[key])) {
                return data.map(() => null);
            }
            const baseVal = baseItem[key];
            return data.map(d => {
                if (isUnpublishedValue(d[key])) return null;
                return parseFloat(((d[key] / baseVal) * 100).toFixed(2));
            });
        }

        function formatChartChangePct(indexVal) {
            if (indexVal == null) return null;
            const pct = (indexVal - 100).toFixed(2);
            const sign = parseFloat(pct) > 0 ? '+' : '';
            return `${sign}${pct}%`;
        }

        function renderTrendsChart() {
            const ctx = document.getElementById('trendsChart').getContext('2d');
            const chartData = getChartDateRange();
            const labels = chartData.map(d => d.date);
            const baseDate = document.getElementById('chart-base-date').value || rawData[0]?.date;
            const changeDate = document.getElementById('chart-change-date').value || rawData[rawData.length - 1]?.date;

            const datasets = [];
            let colorIdx = 0;
            selectedChartKeys.forEach(key => {
                const meta = getIndicatorMeta(key);
                if (!meta) return;
                const color = CHART_COLORS[colorIdx % CHART_COLORS.length];
                colorIdx++;
                const series = getIndexedSeries(key, baseDate, chartData);
                const labelIdx = findSeriesLabelIndex(series, labels, changeDate);
                datasets.push({
                    label: meta.label,
                    data: series,
                    borderColor: color,
                    backgroundColor: color + '18',
                    borderWidth: 2,
                    pointBackgroundColor: color,
                    pointRadius: series.map((_, i) => i === labelIdx ? 4 : 2),
                    pointHoverRadius: 4,
                    pointBorderWidth: 1,
                    tension: 0.3,
                    fill: false,
                    spanGaps: false
                });
            });

            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        changePointLabels: { changeDate },
                        legend: {
                            display: datasets.length > 1,
                            position: 'bottom',
                            labels: { font: { size: 10, family: "'Noto Sans KR'" }, boxWidth: 8, padding: 8 }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => {
                                    if (ctx.parsed.y == null) return `${ctx.dataset.label}: 미고시`;
                                    const idxLine = `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)} (${baseDate}=100)`;
                                    const effectiveIdx = findSeriesLabelIndex(ctx.dataset.data, labels, changeDate);
                                    if (ctx.dataIndex === effectiveIdx) {
                                        const chg = formatChartChangePct(ctx.parsed.y);
                                        const dateNote = labels[effectiveIdx] !== changeDate
                                            ? ` · ${labels[effectiveIdx]} 기준`
                                            : '';
                                        return chg ? `${idxLine} · 변동 ${chg}${dateNote}` : idxLine;
                                    }
                                    return idxLine;
                                }
                            }
                        }
                    },
                    layout: { padding: { right: 52 } },
                    scales: {
                        y: {
                            title: { display: true, text: '지수 (기준=100)', font: { size: 11, weight: 'bold' } },
                            grid: { color: 'rgba(0,0,0,.06)' },
                            ticks: { font: { size: 11, family: "'Noto Sans KR'" } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11, family: "'Noto Sans KR'" } }
                        }
                    }
                }
            });
        }

