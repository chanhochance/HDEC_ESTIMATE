                        if (last[k] != null) {
                            newRow[k] = k.startsWith('fx') || k === 'rebar' || k === 'remicon' || k.startsWith('basic') || k.startsWith('standard')
                                ? Math.round(last[k] * factor)
                                : parseFloat((last[k] * factor).toFixed(1));
                        }
                    });
                    rawData.push(newRow);
                    updated = true;
                }
            });

            if (updated) {
                alert('API 자동 동기화 성공: 국책기관의 최신 당월 확정치·잠정치 데이터가 원장에 자동 누적되었습니다.');
