        const changePointLabelPlugin = {
            id: 'changePointLabels',
            afterDatasetsDraw(chart) {
                const changeDate = chart.options.plugins?.changePointLabels?.changeDate;
                if (!changeDate) return;

                const { ctx, data } = chart;

                const visible = [];
                data.datasets.forEach((dataset, di) => {
                    const meta = chart.getDatasetMeta(di);
                    const labelIdx = findSeriesLabelIndex(dataset.data, data.labels, changeDate);
                    if (meta.hidden || labelIdx < 0 || dataset.data[labelIdx] == null) return;
                    const point = meta.data[labelIdx];
                    if (!point) return;
                    const indexVal = dataset.data[labelIdx];
                    const pct = (indexVal - 100).toFixed(2);
                    const sign = parseFloat(pct) > 0 ? '+' : '';
                    visible.push({
                        point,
                        text: `${sign}${pct}%`,
                        color: dataset.borderColor,
                        pct: parseFloat(pct)
                    });
                });
                if (visible.length === 0) return;

                ctx.save();
                ctx.font = "700 10px 'Noto Sans KR'";
                visible.forEach((item, i) => {
                    const y = item.point.y + (i - (visible.length - 1) / 2) * 13;
                    const x = item.point.x + 8;
                    const metrics = ctx.measureText(item.text);
                    const padX = 4;
                    const boxW = metrics.width + padX * 2;
                    const boxH = 12;
                    ctx.fillStyle = 'rgba(255,255,255,.92)';
                    ctx.strokeStyle = item.color + '55';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.roundRect(x - padX, y - boxH / 2, boxW, boxH, 4);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = item.pct > 0 ? '#c0392b' : item.pct < 0 ? '#0061fe' : '#5e6574';
                    ctx.textAlign = 'left';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(item.text, x, y);
                });
                ctx.restore();
            }
        };
        Chart.register(changePointLabelPlugin);

