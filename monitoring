                        extraEl.innerHTML = `<div class="text-xs opacity-75 pt-1 sim-final-caption" style="margin-top:12px;">변경 공사비 <span style="font-size:10px;">(원화 기준)</span></div><div class="sim-compare-cost" style="margin-top:1px;">${Math.round(result.krwValueChange).toLocaleString()} 원</div>`;
