                    img.style.width = '100%';
                    img.style.height = '100%';
                    clonedCanvas.parentNode.replaceChild(img, clonedCanvas);
                }
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = `물가지표_대시보드_${formatLocalDate()}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }
    </script>
</body>

</html>
