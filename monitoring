        function downloadUploadTemplateCsv() {
            if (!requireAdmin('양식 다운로드')) return;
            const headerLine = TEMPLATE_COLUMN_ORDER.join(',');
            const csv = '\uFEFF' + headerLine + '\n';
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = '물가지표_업로드_템플릿.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function handleFileUpload(event) {
            if (!requireAdmin('데이터 업로드')) {
                event.target.value = '';
                return;
            }
            const file = event.target.files[0];
            if (!file) return;

            const ext = file.name.split('.').pop().toLowerCase();

            const onDone = (mergedCount, sheetName) => {
                if (mergedCount <= 0) {
                    const sheetHint = sheetName ? `\n• 읽은 시트: 「${sheetName}」(UP 시트 우선)` : '';
                    alert(`업로드할 유효한 데이터 행을 찾지 못했습니다.${sheetHint}\n\n확인 사항:\n• UP 시트: 1행 헤더 + 2행부터 년월·숫자\n• 년월: 2025-05 / 202505 / 2025.05 형식\n• A열이 비어 있으면 「년월」 헤더 열 기준으로 읽음\n• 헤더 17열 순서: date → 물가지수(4) → 주요자재(4) → 국가고시(4) → 기타지표(4)`);
                } else {
                    alert(`업로드 완료: 총 ${mergedCount}개월 분량의 지표 원장이 갱신·병합되었습니다.`);
                    saveAndRefresh();
                }
                event.target.value = '';
            };

            if (ext === 'csv') {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const rows = parseCsvText(e.target.result);
                    const mergedCount = ingestUploadRows(rows);
                    onDone(mergedCount, 'CSV');
                };
                reader.readAsText(file, 'UTF-8');
                return;
            }

            if (ext === 'xlsx' || ext === 'xls') {
                if (typeof XLSX === 'undefined') {
                    alert('엑셀 처리 라이브러리를 불러오지 못했습니다.\n인터넷 연결 후 페이지를 새로고침하고 다시 시도해 주세요.');
                    event.target.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = (e) => {
                    let parsed = [];
                    let sheetName = '';
                    try {
                        const workbook = XLSX.read(new Uint8Array(e.target.result), {
                            type: 'array',
                            cellDates: false,
                            cellNF: false,
                            cellStyles: false,
                            bookVBA: false
                        });
                        ({ rows: parsed, sheetName } = parseWorkbookUpload(workbook));
                    } catch (err) {
                        console.error('Excel read error:', err);
                        alert('엑셀 파일을 읽는 중 오류가 발생했습니다.\n\n• Excel에서 파일을 닫고 저장 후 다시 시도\n• UP 시트에 1행 헤더 + 2행부터 데이터 확인\n• .xlsx 형식인지 확인');
                        event.target.value = '';
                        return;
                    }
                    try {
                        const mergedCount = ingestUploadRows(parsed);
                        if (mergedCount <= 0) {
                            const sheetHint = sheetName ? `\n• 읽은 시트: 「${sheetName}」` : '';
                            alert(`업로드할 유효한 데이터 행을 찾지 못했습니다.${sheetHint}\n\n• UP 시트 1행: 날짜, 건설공사비(주거) …\n• 2행부터: 2021-1 형식 날짜 + 숫자\n• 쉼표(,) 숫자도 가능`);
                        } else {
                            alert(`업로드 완료: 총 ${mergedCount}개월 분량의 지표 원장이 갱신·병합되었습니다.\n(시트: ${sheetName || 'UP'})`);
                            saveAndRefresh();
                        }
                    } catch (err) {
                        console.error('Excel save error:', err);
                        alert('데이터 저장·화면 갱신 중 오류가 발생했습니다.\n브라우저를 새로고침한 뒤 다시 시도해 주세요.');
                    }
                    event.target.value = '';
                };
                reader.readAsArrayBuffer(file);
                return;
            }

            alert('지원 형식: .xlsx, .xls, .csv');
            event.target.value = '';
        }

