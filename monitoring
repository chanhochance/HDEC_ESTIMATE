            if (!result.valid) {
                resetBlock('미고시', '—', '');
                return;
            }

            if (isUsd) {
                const rate = result.rate;
                const rateText = `${rate >= 0 ? '+' : ''}${rate.toFixed(2)}%`;
                const rateClass = rate >= 0 ? 'rate-up' : 'rate-down';
                let rateHTML = '';

                if (result.fxValid && result.fxBase) {
                    const fxRate = (result.fxChange - result.fxBase) / result.fxBase * 100;
                    const fxRateText = `${fxRate >= 0 ? '+' : ''}${fxRate.toFixed(2)}%`;
                    const fxClass = fxRate >= 0 ? 'rate-up' : 'rate-down';
                    rateHTML = `
                        <div style="font-size:12px; margin-bottom:4px; display:flex; justify-content:space-between; align-items:center;">
