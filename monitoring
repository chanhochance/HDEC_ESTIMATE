            const diffEl = document.getElementById(`sim-diff-${suffix}`);
            const extraEl = document.getElementById(`sim-extra-${suffix}`);
            const isUsd = simUnit === 'usd';

            const resetBlock = (rateText, costText, diffText) => {
                rateEl.textContent = rateText;
                rateEl.className = 'sim-compare-rate';
                costEl.textContent = costText;
                diffEl.textContent = diffText;
